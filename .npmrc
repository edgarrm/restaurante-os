# Supply-chain hardening. See .ai/rules/security/supply-chain.md
#
# Never run pre/post-install scripts from dependencies. This is the single
# highest-value control: it neutralises the payload delivery mechanism used by
# the Shai-Hulud-class npm worms.
ignore-scripts=true

# Quarantine window. Refuse to resolve any version published less than 5 days
# ago, so compromised releases have time to be yanked before they reach a
# lockfile. Only affects resolution (`npm install`/`npm update`);
# `npm ci` still installs the pinned lockfile exactly.
#
# Matches the 5-day Dependabot cooldown for github-actions. Note the window
# also applies to `npm audit signatures`, which re-resolves the tree: a
# security pin newer than this window makes that command fail. To land an
# advisory fix that is still inside the window, install it once with
# `--min-release-age=0` and widen this value if the pin must stay resolvable.
min-release-age=5

# Fail `npm audit` on high/critical only, so the CI gate stays actionable.
audit-level=high
